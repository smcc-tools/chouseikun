rules_version = '2';

// 調整くん Firestore セキュリティルール
// 認可モデル：ホスト操作は events.ownerUids（Googleログインのuid）に紐づく。
// 参加者は匿名のまま閲覧・投票のみ可能。
service cloud.firestore {
  match /databases/{database}/documents {

    // 個人のブックマーク（マイイベント一覧）：本人のみ読み書き可
    match /users/{uid}/events/{eventId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 個人設定（振込先口座など）：本人のみ読み書き可
    match /users/{uid}/settings/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // FCMプッシュ通知トークン：本人のみ。送信はCloud Functions(Admin)が読む。
    match /fcmTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /events/{eventId} {
      // 閲覧は誰でも可（参加者がリアルタイム購読するため必須）
      allow read: if true;

      // 作成：ログイン必須（匿名不可）。自分自身を唯一のownerとして登録すること。
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerUids is list
        && request.resource.data.ownerUids.size() == 1
        && request.auth.uid in request.resource.data.ownerUids
        && (!('activeView' in request.resource.data)
            || request.resource.data.activeView is string);

      // クライアントからの削除は不可
      allow delete: if false;

      // 更新：ホスト本人 / 参加者の投票 / 支払済みトグル / 立替割り勘の編集 / 旧イベントの移行クレーム
      //       / 保存期限の延長（イベントを開いた人なら誰でも）
      allow update: if isOwner() || isParticipantWrite() || isPaidToggle() || isWalicaWrite()
                       || isLegacyClaim() || isTtlTouch();
    }

    // ホストコード等の非公開データ：イベントのホストのみ読み書き可（参加者からは読めない）
    match /events/{eventId}/private/{docId} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/events/$(eventId)).data.ownerUids.hasAny([request.auth.uid]);
    }

    // ホスト本人（ownerUidsに含まれるログインユーザー）
    function isOwner() {
      return request.auth != null
        && resource.data.ownerUids is list
        && request.auth.uid in resource.data.ownerUids;
    }

    // 参加者：participants / participantOrder のみ変更可（ホスト専用項目は触れない）
    function isParticipantWrite() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['participants', 'participantOrder']);
    }

    // 参加者の「支払済み」トグル：settle.paid のみ変更可（金額等の精算データは不変）
    function isPaidToggle() {
      return 'settle' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settle'])
        && request.resource.data.settle.diff(resource.data.settle).affectedKeys().hasOnly(['paid']);
    }

    // 立替・割り勘：リンクを開いた誰でも メンバー / 立替 を編集可。
    // 旧イベント(walica:true)と統合イベント(activeView='walica')の両方を許可。
    // ホスト専用項目（name, ownerUids 等）は変更不可。
    //
    // memberDiff は後から入った項目で、メンバーの追加・改名・削除はここに書く。
    // 許可キーに含めていなかったため、参加者の増減操作だけが 403 で弾かれていた
    // （ホストは isOwner() で通るため気づきにくかった）。
    // 参加者は既に participants と expenses を書き換えられるので、
    // この追加で公開範囲が実質的に広がることはない。
    function isWalicaWrite() {
      return (resource.data.walica == true
              || (('activeView' in resource.data) && resource.data.activeView == 'walica'))
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['participants', 'participantOrder', 'expenses', 'memberDiff']);
    }

    // 保存期限(ttl_at)の延長のみ。イベントを開いた人なら誰でも可（閲覧は元々全員に開いている）。
    // 期限を「先に延ばす」方向だけ許し、前倒し＝実質的な削除予約は禁止する。
    // これを許さないと、ホストが不在のまま参加者だけで使っているイベントが1年で消えてしまう。
    function isTtlTouch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ttl_at'])
        && request.resource.data.ttl_at is timestamp
        && (!('ttl_at' in resource.data) || request.resource.data.ttl_at > resource.data.ttl_at);
    }

    // 旧イベント（ownerUids未設定）をログインユーザーがクレーム（移行用・ownerUidsの新規付与のみ・匿名不可）
    function isLegacyClaim() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && !('ownerUids' in resource.data)
        && request.resource.data.ownerUids == [request.auth.uid]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUids']);
    }
  }
}
